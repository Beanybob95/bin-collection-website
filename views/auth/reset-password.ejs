<% layout('layouts/boilerplate')%>
<div class="govuk-width-container">
    <main class="govuk-main-wrapper">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <h1 class="govuk-heading-xl">Set a new password</h1>
                <% if (error) { %>
                <div class="govuk-error-summary" data-module="govuk-error-summary">
                    <div role="alert">
                        <h2 class="govuk-error-summary__title">There is a problem</h2>
                        <div class="govuk-error-summary__body">
                            <ul class="govuk-list govuk-error-summary__list">
                                <li><%= error %></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <% } %>
                <% if (!invalidToken) { %>
                <form action="/reset-password/<%= token %>" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="govuk-form-group">
                        <label class="govuk-label" for="password">
                            New password
                        </label>
                        <div class="govuk-hint">Must be at least 8 characters</div>
                        <input class="govuk-input govuk-input--width-20" id="password" name="password" type="password">
                    </div>
                    <div class="govuk-form-group">
                        <label class="govuk-label" for="confirmPassword">
                            Confirm new password
                        </label>
                        <input class="govuk-input govuk-input--width-20" id="confirmPassword" name="confirmPassword" type="password">
                    </div>
                    <button type="submit" class="govuk-button" data-module="govuk-button">
                        Set new password
                    </button>
                </form>
                <% } else { %>
                <p class="govuk-body">
                    This reset link is invalid or has expired.
                    <a href="/forgot-password" class="govuk-link">Request a new one</a>.
                </p>
                <% } %>
            </div>
        </div>
    </main>
</div>

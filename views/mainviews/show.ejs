<% layout('layouts/boilerplate')%>
<a href="/addresses" class="govuk-back-link">Back</a>
<div class="govuk-width-container">
    <main class="govuk-main-wrapper">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <h1 class="govuk-heading-xl">Find your bin collection date</h1>
                <p class="govuk-body">
                    Lorem ipsum dolor sit amet, consectetur adipisicing elit. Amet animi architecto eveniet in ipsa laudantium.
                </p>
                <dl class="govuk-summary-list">
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">
                            Address
                        </dt>
                        <dd class="govuk-summary-list__value">
                            <%= address.housenumber %> <%= address.roadname %> <br> <%= address.county %><br> <%= address.postcode %>
                        </dd>
                    </div>
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">
                            Contacts
                        </dt>
                        <dd class="govuk-summary-list__value">
                            5 January 1978
                        </dd>
                        <dd class="govuk-summary-list__actions">
                            <a class="govuk-link" href="#">Remove<span class="govuk-visually-hidden"> name</span></a>
                        </dd>
                    </div>
                </dl>
            </div>
        </div>
    </main>
</div>
<% layout('layouts/boilerplate')%>
<a href="/addresses" class="govuk-back-link">Back</a>
<div class="govuk-width-container">
    <main class="govuk-main-wrapper">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-heading-xl">Bin collection schedule</h1>
                <p class="govuk-body">
                    Showing bin collection dates for <strong><%= address.housenumber %> <%= address.roadname %>, <%= address.postcode %></strong>.
                </p>

                <% if (nextCollections.length === 0) { %>
                <p class="govuk-body">
                    No upcoming collection dates are available for this address yet.
                </p>
                <% } else { %>
                <div class="govuk-inset-text">
                    <% for (let nc of nextCollections) { %>
                    <p class="govuk-body">
                        Your next <%= nc.label.toLowerCase() %> collection is <%= nc.date.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %>.
                    </p>
                    <% } %>
                </div>
                <% } %>

                <ul class="govuk-list calendar-legend">
                    <li><span class="calendar-legend-swatch res"></span> Household waste</li>
                    <li><span class="calendar-legend-swatch pod"></span> Recycling & Glass</li>
                    <li><span class="calendar-legend-swatch cgw"></span> Garden waste</li>
                </ul>

                <div class="calendar">
                    <div class="month-year-display">
                        <span id="currentMonthYear">April 2025</span>
                    </div>
                    <div class="calendar-header">
                        <a href="#" id="prevMonth" class="calendar-nav-link">&laquo; Previous</a>
                        <a href="#" id="todayButton" class="calendar-nav-link">Today</a>
                        <a href="#" id="nextMonth" class="calendar-nav-link">Next &raquo;</a>
                    </div>
                    <div class="weekdays">
                        <div>Sun</div>
                        <div>Mon</div>
                        <div>Tue</div>
                        <div>Wed</div>
                        <div>Thu</div>
                        <div>Fri</div>
                        <div>Sat</div>
                    </div>
                    <div id="calendar-grid" class="calendar-grid"></div>
                </div>
            </div>
        </div>
    </main>
</div>
<script type="application/json" id="collections-data"><%- JSON.stringify(binCollections) %></script>
<script src="/javascripts/calendar.js"></script>
<% layout('layouts/boilerplate')%>
<a href="/addresses" class="govuk-back-link">Back</a>
<div class="govuk-width-container">
    <main class="govuk-main-wrapper">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-heading-xl">Bin collection schedule</h1>
                <p class="govuk-body">
                    Showing bin collection dates for <strong><%= address.housenumber %> <%= address.roadname %>, <%= address.postcode %></strong>.
                </p>

                <% if (nextCollections.length === 0) { %>
                <p class="govuk-body">
                    No upcoming collection dates are available for this address yet.
                </p>
                <% } else { %>
                <div class="govuk-inset-text">
                    <% for (let nc of nextCollections) { %>
                    <p class="govuk-body">
                        Your next <%= nc.label.toLowerCase() %> collection is <%= nc.date.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %>.
                    </p>
                    <% } %>
                </div>
                <% } %>

                <ul class="govuk-list calendar-legend">
                    <li><span class="calendar-legend-swatch res"></span> Household waste</li>
                    <li><span class="calendar-legend-swatch pod"></span> Recycling & Glass</li>
                    <li><span class="calendar-legend-swatch cgw"></span> Garden waste</li>
                </ul>

                <div class="calendar">
                    <div class="month-year-display">
                        <span id="currentMonthYear" aria-live="polite">April 2025</span>
                    </div>
                    <div class="calendar-header">
                        <button type="button" id="prevMonth" class="calendar-nav-link">&laquo; Previous</button>
                        <button type="button" id="todayButton" class="calendar-nav-link">Today</button>
                        <button type="button" id="nextMonth" class="calendar-nav-link">Next &raquo;</button>
                    </div>
                    <div class="weekdays" role="row">
                        <div role="columnheader">Sun</div>
                        <div role="columnheader">Mon</div>
                        <div role="columnheader">Tue</div>
                        <div role="columnheader">Wed</div>
                        <div role="columnheader">Thu</div>
                        <div role="columnheader">Fri</div>
                        <div role="columnheader">Sat</div>
                    </div>
                    <div id="calendar-grid" class="calendar-grid" role="grid" aria-label="Bin collection calendar"></div>
                    <ul id="calendar-agenda" class="calendar-agenda govuk-list"></ul>
                </div>
                <p class="govuk-body-s last-refresh-text">Last refresh: <%= address.lastRefresh.toLocaleString('en-gb')%></p>
            </div>
        </div>
    </main>
</div>
<div id="collections-data" data-collections="<%= JSON.stringify(binCollections) %>" hidden></div>
<script src="/javascripts/calendar.js"></script>
<% layout('layouts/boilerplate')%>
<div class="govuk-width-container">
    <main class="govuk-main-wrapper">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <h1 class="govuk-heading-xl">Find your bin collection date</h1>
                <p class="govuk-body">
                    Select a saved address and press Continue to view your bin collection schedule and manage email reminders.
                </p>
                <% if (addresses.length === 0) { %>
                <p class="govuk-body">
                    You have not added any addresses yet. <a href="/addresses/new" class="govuk-link">Add a new address</a> to get started.
                </p>
                <% } else { %>
                <form action="/bincollection/id" method="GET" id="address-picker-form">
                    <div class="govuk-form-group">
                        <label class="govuk-label govuk-label--m" for="address-picker-select">
                            Choose address
                        </label>
                        <div id="address-picker-hint" class="govuk-hint">
                            Select an address from the list, then choose Continue to view its bin collection dates, or Manage Address to edit or remove it.
                        </div>
                        <select class="govuk-select govuk-!-width-one-half" id="address-picker-select" name="address-picker" aria-describedby="address-picker-hint">
                            <% for (let address of addresses) {%>
                            <option value="<%= address._id %>"><%= address.housenumber %> <%= address.roadname %><%}%></option>
                        </select>
                    </div>
                    <div class="govuk-button-group">
                        <button type="button" class="govuk-button" id="selectAddress" data-module="govuk-button">
                            Continue
                        </button>
                        <button type="button" class="govuk-button govuk-button--secondary" id="manageAddress" data-module="govuk-button">
                            Manage Address
                        </button>
                        <button type="button" class="govuk-button govuk-button--secondary" id="addAddress" data-module="govuk-button">
                            Add a new address
                        </button>
                    </div>
                </form>
                <% } %>

            </div>
        </div>
    </main>
</div>
<script src="/javascripts/addresses-index.js"></script>


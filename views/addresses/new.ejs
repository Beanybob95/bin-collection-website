
<% layout('layouts/boilerplate')%>
<a href="<%= backLink %>" class="govuk-back-link">Back</a>
<div class="govuk-width-container">
    <main class="govuk-main-wrapper">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <h1 class="govuk-heading-xl">Save your address</h1>
                <p class="govuk-body">
                    If you have previously saved your address to this website then you can select your address below. Otherwise, you will need to <a href="#" class="govuk-link">Search a new address</a>
                </p>
                <div class="govuk-form-group">
                    <label class="govuk-label" for="postcode">
                        Postcode of your property
                    </label>
                    <input class="govuk-input govuk-input--width-10" id="postcode" name="postcode" type="text">
                    <button type="button" class="govuk-button govuk-button--secondary" id="findAddress" data-module="govuk-button">
                        Find address
                    </button>
                </div>
                <form action="/addresses" method="POST" id="address-picker-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div id="address-results" class="govuk-form-group" style="display: none;">
                        <label class="govuk-label" for="address-select">
                            Select your address
                        </label>
                        <select class="govuk-select" id="address-select" name="uprn">
                            <!-- Address options will be populated here -->
                        </select>
                        <!-- Hidden fields to store address details -->
                        <input type="hidden" id="postcode-hidden" name="postcode">
                        <input type="hidden" id="housenumber-hidden" name="housenumber">
                        <input type="hidden" id="roadname-hidden" name="roadname">
                        <input type="hidden" id="county-hidden" name="county">
                    </div>
                    <button type="submit" class="govuk-button" data-module="govuk-button">
                        Save and continue
                    </button>
                </form>
            </div>
        </div>
    </main>
</div>

<script src="/javascripts/address-picker.js"></script>
<% layout('layouts/boilerplate')%>
<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item">
            <a class="govuk-breadcrumbs__link" href="/addresses">Home</a>
        </li>
        <li class="govuk-breadcrumbs__list-item">
            <a class="govuk-breadcrumbs__link" href="/addresses/<%= address._id %>"><%= address.housenumber%> <%= address.roadname%></a>
        </li>
    </ol>
</nav>
<div class="govuk-width-container">
    <main class="govuk-main-wrapper">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <h1 class="govuk-heading-xl">Add a user</h1>
                <p class="govuk-body">
                    Enter the email address of an existing account. They will start receiving notifications about waste collection days for this address. If they don't have an account yet, ask them to sign up first.
                </p>
                <% if (error) { %>
                <div class="govuk-error-summary" data-module="govuk-error-summary">
                    <div role="alert">
                        <h2 class="govuk-error-summary__title">There is a problem</h2>
                        <div class="govuk-error-summary__body">
                            <ul class="govuk-list govuk-error-summary__list">
                                <li><%= error %></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <% } %>
                <form action="/addresses/<%= address._id %>/users" method="POST" id="add-user-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="govuk-form-group">
                        <label class="govuk-label" for="email">
                            Enter their email address
                        </label>
                        <input class="govuk-input govuk-input--width-20" id="email" name="email" type="email">
                    </div>
                    <button type="submit" class="govuk-button" data-module="govuk-button">
                        Save and continue
                    </button>
                </form>
            </div>
        </div>
    </main>
</div>
